ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# コード実行サブエージェント用（Phase 4以降で使用。未導入の間は空でよい）
OPENAI_API_KEY=sk-xxxxxxxx

# ①ピアノ教室: アクセス分析用（Search Console / GA4）。未導入の間は空でよい
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
SEARCH_CONSOLE_SITE_URL=https://example.com/
GA4_PROPERTY_ID=123456789

# 会話の LLM（ハーネス、../docs/spec.md §3.4.12）。既定は claude（claude → codex → ollama）。auto はおまかせ
# JARVIS_HARNESS=claude
# 会話ごとのセッション（1）／毎回 1 回限り（0）
# JARVIS_HARNESS_SESSION=1
# Claude の道具（Jarvis の MCP の 4 つ）と Web 検索。0 で出さない
# JARVIS_HARNESS_TOOLS=1
# JARVIS_WEB_SEARCH=1
# 引き継ぎメモにそのまま入れる直近の往復・セッションを閉じる無発言の分
# JARVIS_HANDOFF_EXCHANGES=6
# JARVIS_SESSION_IDLE_MIN=30

